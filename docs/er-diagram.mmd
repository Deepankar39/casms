
erDiagram
    ROLES ||--o{ USERS : has
    DEPARTMENTS ||--o{ USERS : employs
    BUILDINGS ||--o{ ROOMS : contains
    DEPARTMENTS |o--o{ ROOMS : manages
    DEPARTMENTS ||--o{ ASSETS : owns
    ROOMS ||--o{ ASSETS : stores
    ASSET_CATEGORIES ||--o{ ASSETS : classifies
    ASSET_STATUSES ||--o{ ASSETS : defines
    ASSETS |o--o{ ASSETS : parent_of
    ASSETS ||--o{ ASSET_ASSIGNMENTS : has
    USERS |o--o{ ASSET_ASSIGNMENTS : receives
    ASSETS ||--o{ SERVICE_REQUESTS : has
    USERS ||--o{ SERVICE_REQUESTS : raises
    USERS |o--o{ SERVICE_REQUESTS : handles
    REQUEST_STATUSES ||--o{ SERVICE_REQUESTS : defines
    PRIORITIES ||--o{ SERVICE_REQUESTS : sets
    SERVICE_REQUESTS ||--o{ MAINTENANCE_RECORDS : records
    ASSETS ||--o{ MAINTENANCE_RECORDS : serviced
